# Solace Cloud REST API (Mission Control) credentials.
# Create a token in the Solace Cloud console: Mission Control > API Tokens.
SOLACE_CLOUD_API_TOKEN=CHANGEME_bearer_token_with_services_scope
SOLACE_CLOUD_API_BASE=https://api.solace.cloud/api/v2

# Used by get-broker-manager-credentials.sh. AWS and Azure live in one
# Solace Cloud organization, STACKIT in another, each with its own token
# and API base URL (see ../terraform/README.md) -- the STACKIT org's API
# base can differ from api.solace.cloud. Each token needs the "Get My
# Services with Management Credentials" (or org-wide "Get Services with
# Management Credentials") scope to get adminUsername/adminPassword back.
AWS_AZURE_ORG_API_TOKEN=CHANGEME_bearer_token_for_the_aws_azure_org
AWS_AZURE_ORG_API_BASE=https://api.solace.cloud/api/v2
STACKIT_ORG_API_TOKEN=CHANGEME_bearer_token_for_the_stackit_org
STACKIT_ORG_API_BASE=CHANGEME_stackit_org_api_base_url

# Event broker service IDs (not secrets, but change whenever a service is
# re-created -- see terraform output or output/service-<name>.json "id").
AWS_SERVICE_ID=CHANGEME_aws_service_id
AZURE_SERVICE_ID=CHANGEME_azure_service_id
STACKIT_SERVICE_ID=CHANGEME_stackit_service_id

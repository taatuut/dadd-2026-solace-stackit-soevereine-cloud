# Copy to .env and fill in the real values once the 3 Solace Cloud services exist.
# All values here are placeholders -- do not commit a real .env file.

# --- Local broker ---
LOCAL_SEMP_HOST=http://localhost:8080
LOCAL_SEMP_USER=admin
LOCAL_SEMP_PASSWORD=admin
LOCAL_SMF_HOST=localhost:55554
LOCAL_WEB_MESSAGING_URL=ws://localhost:8008
LOCAL_MSG_VPN=enewable

# --- AWS US East (Solace Cloud HA service) : receives PUBLIC data ---
# Service ez-dadd-2026-eks-us-east-1a, created 2026-09-28 (public cluster).
# VPN name and host are not secrets and are already known -- confirm the
# port on the Connect tab (55443/TLS assumed) and fill in the bridge
# client-username/password once created (see ../cloud-setup/aws-us-east/README.md).
AWS_REMOTE_VPN=ez-dadd-2026-eks-us-east-1
AWS_REMOTE_SMF_HOST=mr-connection-07w9t1ah76x.messaging.solace.cloud:55443
AWS_BRIDGE_USER=enewable-local-bridge
AWS_BRIDGE_PASSWORD=CHANGEME_bridge_client_password
# SEMP (management) admin credentials for THIS broker -- needed only to run
# cloud-setup/solace-cloud-api/configure-remote-bridge-users.sh, which
# creates AWS_BRIDGE_USER above with a publish-only ACL profile. Find these
# on the Connect tab under the SEMP/management section (NOT the same as
# solace-cloud-client, and NOT the Solace Cloud API token). Confirmed
# 28/09/2026: username is "mission-control-manager", host is the same SMF
# hostname on port 943 -- with or without an "https://" prefix, the script
# accepts both.
AWS_SEMP_HOST=CHANGEME_host:943
AWS_SEMP_ADMIN_USER=CHANGEME_semp_admin_username
AWS_SEMP_ADMIN_PASSWORD=CHANGEME_semp_admin_password

# --- Azure West Europe / Netherlands (Solace Cloud HA service) : non-personal EU data ---
# Service ez-dadd-2026-aks-westeurope, created 2026-09-28 (public cluster).
# VPN name and host are not secrets and are already known -- confirm the
# port on the Connect tab (55443/TLS assumed) and fill in the bridge
# client-username/password once created (see ../cloud-setup/azure-west-europe/README.md).
AZURE_REMOTE_VPN=ez-dadd-2026-aks-westeurop
AZURE_REMOTE_SMF_HOST=mr-connection-1uv2i5bgjkm.messaging.solace.cloud:55443
AZURE_BRIDGE_USER=enewable-local-bridge
AZURE_BRIDGE_PASSWORD=CHANGEME_bridge_client_password
# SEMP (management) admin credentials for THIS broker -- see the AWS section
# above for what this is for and where to find it.
AZURE_SEMP_HOST=CHANGEME_host:943
AZURE_SEMP_ADMIN_USER=CHANGEME_semp_admin_username
AZURE_SEMP_ADMIN_PASSWORD=CHANGEME_semp_admin_password

# --- STACKIT eu01 / Germany : sensitive PII data (sovereign only) ---
# NOTE: until STACKIT is Generally Available in Solace Cloud (expected next
# week), these STACKIT_* values point at the interim stand-in broker
# ez-dadd-2026-STACKIT-gke-gcp-europe-west1-b on GCP europe-west1 (Belgium),
# created 2026-09-28 (public cluster) -- see
# ../cloud-setup/gcp-europe-west1-interim/README.md. VPN name and host are
# not secrets and are already known -- confirm the port on the Connect tab
# (55443/TLS assumed) and fill in the bridge client-username/password once
# created. Swap the values (not the variable names) once the real STACKIT
# eu01 service exists -- see ../cloud-setup/stackit-eu01/README.md.
STACKIT_REMOTE_VPN=ez-dadd-2026-stackit-gke-g
STACKIT_REMOTE_SMF_HOST=mr-connection-gp982rqw5dk.messaging.solace.cloud:55443
STACKIT_BRIDGE_USER=enewable-local-bridge
STACKIT_BRIDGE_PASSWORD=CHANGEME_bridge_client_password
# SEMP (management) admin credentials for THIS broker -- see the AWS section
# above for what this is for and where to find it.
STACKIT_SEMP_HOST=CHANGEME_host:943
STACKIT_SEMP_ADMIN_USER=CHANGEME_semp_admin_username
STACKIT_SEMP_ADMIN_PASSWORD=CHANGEME_semp_admin_password

# --- Publisher client credentials (created by configure-local-broker.sh) ---
PUB_PUBLIC_USER=pub-public
PUB_PUBLIC_PASSWORD=pub-public-pw
PUB_EU_OPS_USER=pub-eu-ops
PUB_EU_OPS_PASSWORD=pub-eu-ops-pw
PUB_EU_PII_USER=pub-eu-pii
PUB_EU_PII_PASSWORD=pub-eu-pii-pw
